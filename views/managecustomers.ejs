<div class="admin-panel">
    <div class="admin-panel-header">
        <div>
            <p class="admin-panel-eyebrow">User Operations</p>
            <h2 class="admin-panel-title">Manage Customers</h2>
            <p class="admin-panel-subtitle">Search and filter customer records quickly.</p>
        </div>
    </div>

    <div class="admin-toolbar">
      <div class="admin-filter-row">
        <input type="search" name="search" id="search-customer" placeholder="Search for customer">
        <select name="filter" id="filter-customer">
          <option value="ALL">All</option>
          <option value="ACTIVE">Active</option>
          <option value="SUSPENDED">Suspended</option>
          <option value="DEACTIVATED">Deactivated</option>
        </select>
        <button type="button" id="filter-btn-customer" class="admin-btn secondary">Filter</button>
      </div>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Status</th>
            <th>Active Jobs</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(customers.length === 0){ %>
            <tr>
              <td colspan="5">No customers found.</td>
            </tr>
          <% }else{ %>
            <% customers.forEach(customer=>{ %>
              <tr>
                <td><%= customer.name %> <%= customer.surname %></td>
                <td><%= customer.address || 'Not provided' %></td>
                <td><%= customer.account_status %></td>
                <td><%= customer.active_jobs %></td>
                <td><button class="admin-btn secondary user-status" data-role="customer" data-id="<%= customer.idusers %>" data-status="<%= customer.account_status === 'SUSPENDED' ? 'ACTIVE' : 'SUSPENDED' %>"><%= customer.account_status === 'SUSPENDED' ? 'Reactivate' : 'Suspend' %></button></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (pagination.pages > 1) { %><nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Customer pages">
      <% if (pagination.page > 1) { %><a class="admin-page-link" href="/admin/managecustomers?page=<%= pagination.page - 1 %>">Previous</a><% } else { %><span></span><% } %>
      <span>Page <%= pagination.page %> of <%= pagination.pages %></span>
      <% if (pagination.page < pagination.pages) { %><a class="admin-page-link" href="/admin/managecustomers?page=<%= pagination.page + 1 %>">Next</a><% } %>
    </nav><% } %>
</div>
    <script>
      // Client-side search and filter for customers
      document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('search-customer');
        const filterSelect = document.getElementById('filter-customer');
        const filterBtn = document.getElementById('filter-btn-customer');
        const tableRows = document.querySelectorAll('tbody tr');

        function filterTable() {
          const searchValue = searchInput.value.toLowerCase();
          const filterValue = filterSelect.value;
          tableRows.forEach(row => {
            const name = row.children[0]?.textContent.toLowerCase() || '';
            
            const status = row.children[2]?.textContent.trim().toUpperCase() || '';
            let show = name.includes(searchValue);
            // If filtering by status, add logic here (currently not in table)
            if (filterValue !== 'ALL') {
              
              show = show && status === filterValue;
            }
            row.style.display = show ? '' : 'none';
          });
        }
        searchInput.addEventListener('input', filterTable);
        filterBtn.addEventListener('click', filterTable);
      });
    </script>
