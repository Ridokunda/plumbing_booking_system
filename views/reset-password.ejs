<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WeFixIt | <%= title %></title><link rel="stylesheet" href="/stylesheets/bootstrap.css"></head><body><%- include('./partials/head') %><main class="container py-5"><div class="row justify-content-center"><div class="col-md-6"><h1>Choose a new password</h1><% if (message) { %><div class="alert alert-danger"><%= message %></div><% } %><form action="/account/reset-password" method="post" class="card card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><label for="password">New password</label><input id="password" name="password" type="password" minlength="10" maxlength="128" class="form-control" required><button type="submit" class="btn btn-primary mt-3">Update password</button></form></div></div></main><%- include('./partials/footer') %></body></html>
