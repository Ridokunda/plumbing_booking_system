<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WeFixIt | <%= title %></title><link rel="stylesheet" href="/stylesheets/bootstrap.css"><link rel="stylesheet" href="/stylesheets/custom.css"></head>
<body><%- include('./partials/head') %><main class="container py-5"><p class="booking-stepper-eyebrow">Scheduling</p><h1>My availability</h1>
<form id="availabilityForm" class="card card-body mb-4"><div class="form-row"><div class="col-md"><label for="startsAt">Starts</label><input id="startsAt" name="starts_at" type="datetime-local" class="form-control" required></div><div class="col-md"><label for="endsAt">Ends</label><input id="endsAt" name="ends_at" type="datetime-local" class="form-control" required></div><div class="col-md"><label for="availabilityType">Type</label><select id="availabilityType" name="availability_type" class="form-control"><option>AVAILABLE</option><option>UNAVAILABLE</option></select></div></div><button class="btn btn-primary mt-3" type="submit">Add availability</button></form>
<div class="list-group"><% availability.forEach(slot => { %><div class="list-group-item d-flex justify-content-between align-items-center"><span><strong><%= slot.availability_type %></strong> · <%= new Date(slot.starts_at).toLocaleString() %> – <%= new Date(slot.ends_at).toLocaleString() %></span><button class="btn btn-sm btn-outline-danger delete-slot" data-id="<%= slot.id %>">Remove</button></div><% }) %></div>
</main><%- include('./partials/footer') %><script>document.getElementById('availabilityForm').addEventListener('submit',async event=>{event.preventDefault();const form=new FormData(event.target);const response=await fetch('/plumber/availability',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(form))});const data=await response.json();if(!response.ok)return alert(data.message);location.reload()});document.querySelectorAll('.delete-slot').forEach(button=>button.addEventListener('click',async()=>{const response=await fetch('/plumber/availability/'+button.dataset.id,{method:'DELETE'});if(response.ok)location.reload()}));</script></body></html>
