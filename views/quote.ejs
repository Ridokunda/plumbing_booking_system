<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WeFixIt | <%= title %></title>
  <link rel="stylesheet" href="/stylesheets/bootstrap.css">
  <link rel="stylesheet" href="/stylesheets/custom.css">
  <link rel="stylesheet" href="/stylesheets/quote.css">
  <%- include('./partials/header-assets') %>
</head>
<body class="quote-page">
  <%- include('./partials/head') %>
  <%
    const role = Number(session.user.usertype);
    const canPrepare = role === 3 && ['ASSIGNED', 'IN_PROGRESS'].includes(booking.status);
    const bookingsUrl = role === 3 ? '/plumber/my-bookings' : role === 2 ? '/admin/bookings' : '/booking/mybookings';
    const money = value => 'R' + Number(value).toLocaleString('en-ZA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  %>
  <main class="container quote-main">
    <a class="quote-back" href="<%= bookingsUrl %>"><span aria-hidden="true">&larr;</span> Back to bookings</a>
    <header class="quote-heading">
      <div>
        <p class="quote-eyebrow">Booking #<%= booking.idbookings %></p>
        <h1>Itemized quote</h1>
        <p class="quote-intro">A clear breakdown of the labour and materials for this job.</p>
      </div>
      <span class="quote-booking-status"><span class="quote-status-dot" aria-hidden="true"></span><%= booking.status.replace(/_/g, ' ').toLowerCase() %></span>
    </header>
    <dl class="quote-booking-details">
      <div><dt>Service</dt><dd><%= booking.type.replace(/_/g, ' ') %></dd></div>
      <div><dt>Location</dt><dd><%= booking.location || 'Address to confirm' %></dd></div>
    </dl>
    <div class="quote-layout <%= canPrepare ? '' : 'quote-layout-single' %>">
      <% if (!quote) { %>
        <section class="quote-panel quote-empty" aria-labelledby="quote-empty-title">
          <svg class="quote-empty-icon" width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
            <rect x="12" y="6" width="32" height="44" rx="5" stroke="currentColor" stroke-width="2"/>
            <path d="M20 18h16M20 26h16M20 34h9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <p class="quote-eyebrow">Quote overview</p>
          <h2 id="quote-empty-title">No quote yet</h2>
          <p><%= canPrepare ? 'Add labour and materials to prepare an itemized quote for your customer.' : 'No quote has been submitted yet. The cost breakdown will appear here once your plumber sends it.' %></p>
        </section>
      <% } else { %>
        <section class="quote-panel quote-summary" aria-labelledby="quote-summary-title">
          <div class="quote-panel-heading">
            <div><p class="quote-eyebrow">Quote overview</p><h2 id="quote-summary-title"><%= quote.quote_number %></h2></div>
            <span class="quote-status" data-status="<%= quote.status %>"><%= quote.status.toLowerCase() %></span>
          </div>
          <div class="quote-table-scroll" role="region" aria-label="Itemized quote costs" tabindex="0">
            <table class="quote-table">
              <caption class="sr-only">Labour and material costs for booking #<%= booking.idbookings %></caption>
              <thead><tr><th scope="col">Description</th><th scope="col">Qty</th><th scope="col">Unit price</th><th scope="col">Total</th></tr></thead>
              <tbody>
                <% items.forEach(item => { %>
                  <tr><td><%= item.description %></td><td><%= Number(item.quantity) %></td><td><%= money(item.unit_price) %></td><td><%= money(item.line_total) %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <dl class="quote-totals">
            <div><dt>Subtotal</dt><dd><%= money(quote.subtotal) %></dd></div>
            <div><dt>Tax</dt><dd><%= money(quote.tax_amount) %></dd></div>
            <div class="quote-grand-total"><dt>Total</dt><dd><%= money(quote.total_amount) %></dd></div>
          </dl>
          <% if (role === 1 && quote.status === 'SENT') { %>
            <div class="quote-decision">
              <p>Review the breakdown above, then approve or reject this quote.</p>
              <div class="quote-actions">
                <button type="button" class="btn quote-button-primary quote-response" data-decision="APPROVED">Approve quote</button>
                <button type="button" class="btn quote-button-danger quote-response" data-decision="REJECTED">Reject quote</button>
              </div>
              <p class="quote-error" id="quoteResponseError" role="alert" hidden></p>
            </div>
          <% } %>
        </section>
      <% } %>
      <% if (canPrepare) { %>
        <section class="quote-panel quote-editor" aria-labelledby="quote-editor-title">
          <div class="quote-panel-heading">
            <div><p class="quote-eyebrow">Quote builder</p><h2 id="quote-editor-title">Prepare a new quote</h2></div>
          </div>
          <p class="quote-editor-intro">Add each cost below. Enter unit prices in rand.</p>
          <form id="quoteForm" action="/quotes/booking/<%= booking.idbookings %>" method="post">
            <div id="quoteItems">
              <div class="quote-item" role="group" aria-label="Line item 1">
                <label class="quote-description-field">Description<input class="form-control item-description" name="description" placeholder="Labour or material" maxlength="500" required></label>
                <label>Qty<input class="form-control item-quantity" name="quantity" type="number" min="0.01" max="1000" step="0.01" value="1" required></label>
                <label>Unit price (R)<input class="form-control item-price" name="unitPrice" type="number" min="0" step="0.01" placeholder="0.00" required></label>
              </div>
            </div>
            <button type="button" id="addItem" class="btn quote-button-add"><span aria-hidden="true">+</span> Add item</button>
            <div class="quote-submit">
              <p>The customer will receive this quote for review.</p>
              <button type="submit" class="btn quote-button-primary">Send quote <span aria-hidden="true">&rarr;</span></button>
            </div>
            <p class="quote-error" id="quoteFormError" role="alert" hidden></p>
          </form>
        </section>
      <% } %>
    </div>
  </main>
  <%- include('./partials/footer') %>
  <script src="/javascripts/quote.js" data-quote-id="<%= quote ? quote.idquote : 0 %>"></script>
</body>
</html>
