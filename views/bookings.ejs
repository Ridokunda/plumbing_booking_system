<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WeFixIt | <%= title %></title>
    <link rel="stylesheet" href="/stylesheets/custom.css">
    <!-- slider stylesheet -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="/stylesheets/bootstrap.css" />
    <!-- font awesome style -->
    <link rel="stylesheet" type="text/css" href="/stylesheets/font-awesome.min.css" />
    <!-- Custom styles for this template -->
    <link href="/stylesheets/style.css" rel="stylesheet" />
    <!-- responsive style -->
    <link href="/stylesheets/responsive.css" rel="stylesheet" />
</head>
<body>
    
    <div class="mybookings-container">
        <div class="mybookings-header">
            <h3>Admin Bookings</h3>
        </div>
        <div class="search-filter-bar">
            <input type="text" id="searchInput" class="search-input" placeholder="Search bookings">
            <select id="statusFilter" class="status-filter">
                <option value="ALL">ALL STATUS</option>
                <option value="NEW">NEW</option>
                <option value="ASSIGNED">ASSIGNED</option>
                <option value="CANCELLED">CANCELLED</option>
                <option value="DECLINED">DECLINED</option>
                <option value="COMPLETED">COMPLETED</option>
                <option value="IN_PROGRESS">IN PROGRESS</option>
            </select>
        </div>
        <div class="bookings-grid" id="bookingsGrid">
            <% bookings.forEach(booking => { %>
                <div class="booking-card" data-status="<%= booking.status %>" data-type="<%= booking.type %>" data-date="<%= booking.date_start %>" data-search="<%= booking.customer_name %> <%= booking.type %> <%= booking.status %> <%= booking.date_start %>">
                    <div class="card-row card-row-top">
                        <div class="service-type">Customer</div>
                        <span class="service-badge"><%= booking.type %></span>
                    </div>
                    <div class="service-type" style="font-size:1.25em; margin-bottom:2px;"><%= booking.customer_name %></div>
                    <div class="booking-date" data-date="<%= booking.date_start %>"></div>
                    <div class="card-row card-row-bottom">
                        <span class="status-label status-<%= booking.status %>"><%= booking.status %></span>
                    </div>
                    <div class="status-roadmap">
                        <% booking.lifecycle.steps.forEach(step => { %>
                            <span class="status-chip <%= step.current ? 'is-current' : step.completed ? 'is-complete' : '' %>"><%= step.label %></span>
                        <% }); %>
                    </div>
                    <div class="status-note"><strong>Next:</strong> <%= booking.lifecycle.nextAction %></div>
                    <div style="margin-top:8px; color:#666; font-size:0.9em;">
                        <strong>Description:</strong> <%= booking.description || '' %>
                    </div>
                    <div class="role-action-bar">
                        <div class="role-action-label">Recommended actions</div>
                        <% if (booking.status === 'NEW' || booking.status === 'PENDING') { %>
                            <button class="assign-btn role-action-btn assign" data-booking-id="<%= booking.idbookings %>">Assign Plumber</button>
                            <button class="decline-btn role-action-btn decline" data-booking-id="<%= booking.idbookings %>">Decline</button>
                        <% } else { %>
                            <span style="color:#666; font-style:italic;">No actions available</span>
                        <% } %>
                    </div>
                    <% if (booking.amount) { %><p class="booking-amount-row"><strong>Approved amount:</strong> R<%= Number(booking.amount).toFixed(2) %></p><% } %>
                    <a href="/jobs/<%= booking.idbookings %>" class="booking-mini-btn">Open job record</a>
                </div>
            <% }); %>
        </div>
        <% if (pagination.pages > 1) { %><nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Booking pages">
          <% if (pagination.page > 1) { %><a class="admin-page-link" href="/admin/bookings?page=<%= pagination.page - 1 %>">Previous</a><% } else { %><span></span><% } %>
          <span>Page <%= pagination.page %> of <%= pagination.pages %></span>
          <% if (pagination.page < pagination.pages) { %><a class="admin-page-link" href="/admin/bookings?page=<%= pagination.page + 1 %>">Next</a><% } %>
        </nav><% } %>
        <div id="message" style="margin:20px; display:none; padding:10px; border-radius:5px;"></div>
    </div>

    <!-- Assign Plumber Modal -->
    <div id="assignModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); z-index:1000; align-items:center; justify-content:center;">
        <div class="modal-content" style="background:#fff; border-radius:12px; max-width:500px; width:90%; margin:auto; padding:32px 24px; position:relative; box-shadow:0 4px 24px rgba(0,0,0,0.15);">
            <span id="closeAssignModal" style="position:absolute; top:16px; right:20px; font-size:1.8em; color:#888; cursor:pointer;">&times;</span>
            <h3 style="margin-top:0; color:#0f7e94;">Schedule a plumber</h3>
            <div class="form-group"><label for="scheduleStart">Starts</label><input class="form-control" type="datetime-local" id="scheduleStart" required></div>
            <div class="form-group"><label for="scheduleEnd">Ends</label><input class="form-control" type="datetime-local" id="scheduleEnd" required></div>
            <div id="plumbersList">
                <% plumbers.forEach(plumber => { %>
                    <div class="assign-modal-row">
                        <span><%= plumber.name %> <%= plumber.surname %></span>
                        <button class="assign-plumber-btn modal-assign-btn" data-plumber-id="<%= plumber.idusers %>" data-booking-id="">Schedule</button>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <script>
        // Format booking dates
        document.querySelectorAll('.booking-date').forEach(function(el) {
            var dateStr = el.getAttribute('data-date');
            if (dateStr) {
                var date = new Date(dateStr);
                var options = { weekday: 'long', year: 'numeric', month: 'long', day: '2-digit' };
                el.textContent = date.toLocaleDateString(undefined, options);
            }
        });

        // Assign plumber
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('assign-btn')) {
                const bookingId = e.target.getAttribute('data-booking-id');
                document.getElementById('assignModal').style.display = 'flex';
                document.querySelectorAll('.assign-plumber-btn').forEach(btn => {
                    btn.setAttribute('data-booking-id', bookingId);
                });
            }
            if (e.target.classList.contains('assign-plumber-btn')) {
                const bookingId = e.target.getAttribute('data-booking-id');
                const plumberId = e.target.getAttribute('data-plumber-id');
                const startsAt = document.getElementById('scheduleStart').value;
                const endsAt = document.getElementById('scheduleEnd').value;
                if (!startsAt || !endsAt) return alert('Choose a start and end time.');
                fetch('/admin/schedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ booking_id: bookingId, plumber_id: plumberId, starts_at: startsAt, ends_at: endsAt })
                }).then(r => r.json()).then(res => {
                    alert(res.message);
                    if (res.message.includes('successfully')) {
                        document.getElementById('assignModal').style.display = 'none';
                        location.reload();
                    }
                });
            }
            if (e.target.classList.contains('decline-btn')) {
                const bookingId = e.target.getAttribute('data-booking-id');
                const reason = prompt('Why is this booking being declined?');
                if (reason && reason.trim().length >= 5) {
                    fetch('/admin/declinebooking', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ booking_id: bookingId, reason: reason.trim() })
                    }).then(r => r.json()).then(res => {
                        alert(res.message);
                        if (res.message.includes('declined')) location.reload();
                    });
                }
            }
        });

        // Close modal
        document.getElementById('closeAssignModal').addEventListener('click', function() {
            document.getElementById('assignModal').style.display = 'none';
        });
    </script>
    <script src="/javascripts/jwt-handler.js"></script>
</body>
</html>
