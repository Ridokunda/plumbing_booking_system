<div class="admin-panel">
    <div class="admin-panel-header">
        <div>
            <p class="admin-panel-eyebrow">User Operations</p>
            <h2 class="admin-panel-title">Manage Users</h2>
            <p class="admin-panel-subtitle">Jump into customer and plumber lists or add a new account.</p>
        </div>
        <button id="btn_adduser" data-url="/register/registeruser" class="admin-btn">Add user</button>
    </div>

    <div class="admin-metric-grid stats-container stats">
        <a href="#" id="customers-link" class="admin-metric-card stat-card">
            <p class="admin-metric-label stat-title">Active Customers</p>
            <p class="admin-metric-value stat-value"><%= customerCount %></p>
        </a>
        <a href="#" id="plumbers-link" class="admin-metric-card stat-card">
            <p class="admin-metric-label stat-title">Active Plumbers</p>
            <p class="admin-metric-value stat-value"><%= plumberCount %></p>
        </a>
    </div>
</div>