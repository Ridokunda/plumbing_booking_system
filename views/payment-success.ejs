<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WeFixIt | <%= title %></title>
  <link rel="stylesheet" href="/stylesheets/payment.css">
  <%- include('./partials/header-assets') %>
</head>
<body class="payment-page">
  <%- include('./partials/head') %>
  <main class="payment-content">
    <section class="payment-panel payment-success" aria-labelledby="payment-success-title">
      <div class="payment-success-icon" aria-hidden="true">&#10003;</div>
      <p class="payment-eyebrow">Booking #<%= booking_id %></p>
      <h1 id="payment-success-title"><%= receipt?.isSimulated ? 'Demo payment successful' : 'Payment successful' %></h1>
      <p class="payment-muted"><%= receipt?.isSimulated ? 'Your simulation is complete. No real money was charged or transferred.' : 'Thank you. Your payment has been recorded.' %></p>
      <% if (receipt) { %>
        <dl class="payment-details">
          <div><dt><%= receipt.isSimulated ? 'Demo receipt' : 'Receipt number' %></dt><dd><%= receipt.receiptNumber %></dd></div>
          <div><dt>Amount recorded</dt><dd><%= new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(receipt.amount) %></dd></div>
          <div><dt>Recorded at</dt><dd><%= new Date(receipt.paidAt).toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg' }) %></dd></div>
        </dl>
      <% } %>
      <a class="payment-button primary" href="/payment/receipt/<%= booking_id %>">View <%= receipt?.isSimulated ? 'demo receipt' : 'receipt' %> &rarr;</a>
      <div class="payment-success-links"><a href="/payment/history">Invoice &amp; receipt history</a><a href="/booking/mybookings">Back to my bookings</a></div>
    </section>
  </main>
</body>
</html>
