<div class="admin-panel">
    <div class="admin-panel-header">
        <div>
            <p class="admin-panel-eyebrow">User Operations</p>
            <h2 class="admin-panel-title">Manage Plumbers</h2>
            <p class="admin-panel-subtitle">Monitor availability and activity across the plumber team.</p>
        </div>
    </div>

    <div class="admin-toolbar">
      <div class="admin-filter-row">
        <input type="search" name="search" id="search-plumber" placeholder="Search for plumber">
        <select name="filter" id="filter-plumber">
          <option value="ALL">All</option>
          <option value="AVAILABLE">AVAILABLE</option>
          <option value="OFFLINE">NOT AVAILABLE</option>
        </select>
        <button type="button" id="filter-btn-plumber" class="admin-btn secondary">Filter</button>
      </div>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Verification</th>
            <th>Service area</th>
            <th>Active Jobs</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(plumbers.length === 0){ %>
            <tr>
              <td colspan="5">No plumbers found.</td>
            </tr>
          <% }else{ %>
            <% plumbers.forEach(plumber=>{ %>
              <tr>
                <td><%= plumber.name %> <%= plumber.surname %></td>
                <td><%= plumber.verification_status || 'PENDING' %> / <%= plumber.account_status %></td>
                <td><%= plumber.service_area || 'Not provided' %></td>
                <td><%= plumber.active_jobs %></td>
                <td>
                  <% if (plumber.verification_status !== 'APPROVED') { %><button class="admin-btn approve-plumber" data-id="<%= plumber.idusers %>">Approve</button><% } %>
                  <% if (plumber.verification_status !== 'REJECTED') { %><button class="admin-btn danger reject-plumber" data-id="<%= plumber.idusers %>">Reject</button><% } %>
                  <button class="admin-btn secondary user-status" data-role="plumber" data-id="<%= plumber.idusers %>" data-status="<%= plumber.account_status === 'SUSPENDED' ? 'ACTIVE' : 'SUSPENDED' %>"><%= plumber.account_status === 'SUSPENDED' ? 'Reactivate' : 'Suspend' %></button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (pagination.pages > 1) { %><nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Plumber pages">
      <% if (pagination.page > 1) { %><a class="admin-page-link" href="/admin/manageplumbers?page=<%= pagination.page - 1 %>">Previous</a><% } else { %><span></span><% } %>
      <span>Page <%= pagination.page %> of <%= pagination.pages %></span>
      <% if (pagination.page < pagination.pages) { %><a class="admin-page-link" href="/admin/manageplumbers?page=<%= pagination.page + 1 %>">Next</a><% } %>
    </nav><% } %>
</div>
    <script>
      // Client-side search and filter for plumbers
      document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('search-plumber');
        const filterSelect = document.getElementById('filter-plumber');
        const filterBtn = document.getElementById('filter-btn-plumber');
        const tableRows = document.querySelectorAll('tbody tr');

        function filterTable() {
          const searchValue = searchInput.value.toLowerCase();
          const filterValue = filterSelect.value;
          tableRows.forEach(row => {
            const name = row.children[0]?.textContent.toLowerCase() || '';
            const status = row.children[1]?.textContent.toUpperCase() || '';
            let show = name.includes(searchValue);
            if (filterValue !== 'ALL') {
              show = show && status === filterValue;
            }
            row.style.display = show ? '' : 'none';
          });
        }
        searchInput.addEventListener('input', filterTable);
        filterBtn.addEventListener('click', filterTable);
      });
    </script>
