<div class="admin-panel admin-analytics-panel">
    <div class="admin-panel-header">
        <div>
            <p class="admin-panel-eyebrow">Dashboard</p>
            <h2 class="admin-panel-title">Analytics Overview</h2>
            <p class="admin-panel-subtitle">Live snapshot of platform activity and booking performance.</p>
        </div>
    </div>

    <div class="admin-metric-grid">
        <div class="admin-metric-card">
            <p class="admin-metric-label">Total Bookings</p>
            <p class="admin-metric-value"><%= stats.totalBookings %></p>
        </div>
        <div class="admin-metric-card">
            <p class="admin-metric-label">Total Customers</p>
            <p class="admin-metric-value"><%= stats.totalCustomers %></p>
        </div>
        <div class="admin-metric-card">
            <p class="admin-metric-label">Total Plumbers</p>
            <p class="admin-metric-value"><%= stats.totalPlumbers %></p>
        </div>
        <div class="admin-metric-card">
            <p class="admin-metric-label">Completed Bookings</p>
            <p class="admin-metric-value"><%= stats.completedBookings %></p>
        </div>
        <div class="admin-metric-card">
            <p class="admin-metric-label">Paid Revenue</p>
            <p class="admin-metric-value">R<%= Number(stats.revenue || 0).toFixed(2) %></p>
        </div>
        <div class="admin-metric-card">
            <p class="admin-metric-label">Average Turnaround</p>
            <p class="admin-metric-value"><%= stats.averageTurnaroundHours || '—' %> hours</p>
        </div>
    </div>

    <div class="analytics-tables">
        <section class="analytics-card" aria-labelledby="booking-status-heading">
            <div class="analytics-card-heading">
                <h3 id="booking-status-heading">Booking status mix</h3>
                <p>Current distribution across booking stages.</p>
            </div>
            <div class="analytics-table-wrap">
                <table class="analytics-table" aria-labelledby="booking-status-heading">
                    <thead><tr><th scope="col">Status</th><th scope="col" class="analytics-number">Bookings</th></tr></thead>
                    <tbody>
                        <% statusBreakdown.forEach((row) => { %>
                            <tr>
                                <th scope="row"><span class="analytics-status" data-status="<%= row.status %>"><%= row.status.toLowerCase().replace(/_/g, ' ') %></span></th>
                                <td class="analytics-number"><%= Number(row.total || 0).toLocaleString('en-ZA') %></td>
                            </tr>
                        <% }) %>
                        <% if (!statusBreakdown.length) { %>
                            <tr><td colspan="2" class="analytics-table-empty">No bookings yet. Status totals will appear here.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
        <section class="analytics-card" aria-labelledby="monthly-trend-heading">
            <div class="analytics-card-heading">
                <h3 id="monthly-trend-heading">Six-month trend</h3>
                <p>Monthly bookings and paid revenue.</p>
            </div>
            <div class="analytics-table-wrap">
                <table class="analytics-table" aria-labelledby="monthly-trend-heading">
                    <thead><tr><th scope="col">Month</th><th scope="col" class="analytics-number">Bookings</th><th scope="col" class="analytics-number">Revenue</th></tr></thead>
                    <tbody>
                        <% monthlyTrend.forEach((row) => { %>
                            <tr>
                                <th scope="row"><time datetime="<%= row.month %>"><%= new Date(row.month + '-01T12:00:00Z').toLocaleDateString('en-ZA', { month: 'short', year: 'numeric', timeZone: 'Africa/Johannesburg' }) %></time></th>
                                <td class="analytics-number"><%= Number(row.bookings || 0).toLocaleString('en-ZA') %></td>
                                <td class="analytics-number analytics-revenue">R<%= Number(row.revenue || 0).toLocaleString('en-ZA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                            </tr>
                        <% }) %>
                        <% if (!monthlyTrend.length) { %>
                            <tr><td colspan="3" class="analytics-table-empty">No activity in this period. Monthly totals will appear here.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
