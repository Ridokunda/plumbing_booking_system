<div class="hero_area">
  <header class="header_section">
    <div class="header_bottom">
      <div class="container-fluid">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="/" style="color: rgb(15, 126, 148); font-weight: bold; font-size: 24px; font-family: Arial, Helvetica, sans-serif;">
            <span>
              WeFixIt
            </span>
          </a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class=""> </span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ">
              <li class="nav-item active">
                <a class="nav-link" href="/">Home <span class="sr-only">(current)</span></a>
              </li>
              <% if(session.user && session.user.usertype === 1){ %>
                <li class="nav-item">
                  <a class="nav-link" href="/booking/mybookings">My Bookings</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/payment/history">Invoices</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/profile">Profile</a>
                </li>
              <% } %>
              <% if(session.user && session.user.usertype === 2){ %>
                  <li class="nav-item">
                    <a class="nav-link" href="/admin">Dashboard</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/profile">Profile</a>
                  </li>
              <% } %>
              <% if(session.user && session.user.usertype === 3){ %>
                  <li class="nav-item">
                    <a class="nav-link" href="/plumber/my-bookings">Dashboard</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/profile">Profile</a>
                  </li>
              <% } %>
              <li class="nav-item">
                <a class="nav-link" href="/index/about"> About</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/index/service">Services</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/index/contact">Contact Us</a>
              </li>
              <% if(session.user){ %>
                <li class="nav-item">
                  <a class="nav-link" href="/support"><%= session.user.usertype === 2 ? 'Cases' : 'Support' %></a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/notifications">Notifications <span id="notification-count" class="notification-badge" <%= notificationCount ? '' : 'hidden' %>><%= notificationCount || 0 %></span></a>
                </li>
                <li class="nav-item">
                  <form action="/login/logout" method="post" class="nav-link-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="nav-link nav-link-button" type="submit">Logout</button></form>
                </li>
              <% } else { %>
                <li class="nav-item">
                  <a class="nav-link" href="/login">Login</a>
                </li>
              <% } %>
            </ul>
          </div>
        </nav>
      </div>
    </div>
  </header>
</div>
<script src="/javascripts/jwt-handler.js"></script>
<% if (session.user) { %>
<script>
  (() => {
    const badge = document.getElementById('notification-count');
    if (!badge || !window.EventSource) return;
    const stream = new EventSource('/notifications/stream');
    stream.addEventListener('unread', (event) => {
      const count = Number(JSON.parse(event.data).unreadCount || 0);
      badge.textContent = String(count);
      badge.hidden = count === 0;
    });
  })();
</script>
<% } %>
