<%
  const headerUser = typeof session !== 'undefined' ? session.user : null;
  const headerRole = Number(headerUser?.usertype);
  const headerPath = typeof currentPath === 'string' ? currentPath : '/';
  const headerLinks = [{ href: '/', label: 'Home' }];
  if (headerRole === 1) {
    headerLinks.push({ href: '/booking/mybookings', label: 'My Bookings' }, { href: '/payment/history', label: 'Invoices' });
  } else if (headerRole === 2) {
    headerLinks.push({ href: '/admin', label: 'Dashboard' });
  } else if (headerRole === 3) {
    headerLinks.push({ href: '/plumber/my-bookings', label: 'Dashboard' }, { href: '/plumber/availability', label: 'My availability' });
  }
  if (headerUser) headerLinks.push({ href: '/profile', label: 'Profile' });
  headerLinks.push({ href: '/index/about', label: 'About' }, { href: '/index/service', label: 'Services' }, { href: '/index/contact', label: 'Contact Us' });
  if (headerUser) {
    headerLinks.push({ href: '/support', label: headerRole === 2 ? 'Cases' : 'Support' }, { href: '/notifications', label: 'Notifications', notifications: true });
  } else {
    headerLinks.push({ href: '/login', label: 'Login' });
  }
  const headerIsActive = href => {
    if (href === '/') return ['/', '/index', '/index/'].includes(headerPath);
    if (href === '/payment/history') return headerPath === '/payment' || headerPath.startsWith('/payment/');
    return headerPath === href || headerPath.startsWith(href + '/') || (href.startsWith('/index/') && headerPath === href.slice(6));
  };
  const headerUnread = typeof notificationCount === 'number' ? notificationCount : 0;
%>
<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a class="site-brand" href="/" aria-label="WeFixIt home">WeFixIt</a>
    <button class="site-nav-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" hidden>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span>Menu</span>
    </button>
    <ul class="site-nav-links" id="site-navigation">
      <% headerLinks.forEach(link => { %>
        <li>
          <a class="site-nav-link" href="<%= link.href %>" <%- headerIsActive(link.href) ? 'aria-current="page"' : '' %>>
            <%= link.label %>
            <% if (link.notifications) { %>
              <span id="notification-count" class="site-unread-count" aria-label="<%= headerUnread %> unread notifications" <%= headerUnread ? '' : 'hidden' %>><%= headerUnread %></span>
            <% } %>
          </a>
        </li>
      <% }); %>
      <% if (headerUser) { %>
        <li class="site-logout">
          <form action="/login/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="site-nav-link site-logout-button" type="submit">Logout</button>
          </form>
        </li>
      <% } %>
    </ul>
  </nav>
</header>
<script src="/javascripts/jwt-handler.js"></script>
