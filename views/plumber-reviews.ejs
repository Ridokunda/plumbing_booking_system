<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WeFixIt | <%= title %></title><link rel="stylesheet" href="/stylesheets/bootstrap.css"><link rel="stylesheet" href="/stylesheets/custom.css"></head><body><%- include('./partials/head') %><main class="container py-5"><h1><%= plumber.name %> <%= plumber.surname %></h1><p><strong><%= plumber.average_rating || 'New' %></strong><% if (plumber.average_rating) { %>/5 from <%= plumber.review_count %> reviews<% } %> · <%= plumber.service_area || 'Service area unavailable' %></p><div class="row"><% reviews.forEach(review => { %><article class="col-md-6 mb-3"><div class="card h-100"><div class="card-body"><h2 class="h5"><%= review.rating %>/5</h2><p><%= review.comment || 'No written comment.' %></p><small><%= review.customer_name %> · <%= new Date(review.created_at).toLocaleDateString() %></small></div></div></article><% }) %></div></main><%- include('./partials/footer') %></body></html>
