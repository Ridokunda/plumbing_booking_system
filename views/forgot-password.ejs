<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WeFixIt | <%= title %></title><link rel="stylesheet" href="/stylesheets/bootstrap.css"></head><body><%- include('./partials/head') %><main class="container py-5"><div class="row justify-content-center"><div class="col-md-6"><h1>Reset your password</h1><% if (message) { %><div class="alert alert-info"><%= message %></div><% } %><form action="/account/forgot-password" method="post" class="card card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="email">Email</label><input id="email" name="email" type="email" class="form-control" required><button type="submit" class="btn btn-primary mt-3">Send reset link</button></form></div></div></main><%- include('./partials/footer') %></body></html>
