<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/custom.css">
</head>
<body>
    <div class="admin-container">
        <div class="sidebar">
            <div class="logo">
                <h1>WeFixIt</h1>
            </div>
            <div class="admin-pages">
                <ul>
                    <li><a  href="/">Home</a></li>
                    <li>
                        <a href="/notifications">Notifications
                            <% if (notificationCount && notificationCount > 0) { %>
                                <span class="notification-badge"><%= notificationCount %></span>
                            <% } %>
                        </a>
                    </li>
                    <li><a class="link" href="/admin/stats" id="stats-link">Dashboard Analytics</a></li>
                    <li><a class="link" href="/admin/manageusers" id="user-management-link">User management</a></li>
                    <li><a class="link" href="/admin/bookings" id="bookings-link">Bookings</a></li>
                    <li><a href="/admin/contacts">Contact messages</a></li>
                    <li><a href="/support">Operations cases</a></li>
                </ul>
            </div>
            <div class="logout-section">
                <form action="/login/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Logout</button></form>
            </div>
        </div>
        <div class="content"></div>
    </div>
    <script src="/javascripts/admin-dashboard.js"></script>
    <script src="/javascripts/jwt-handler.js"></script>
</body>
</html>
